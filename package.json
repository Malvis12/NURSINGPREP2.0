{
  "name": "nursing-cbt-question-bank",
  "version": "1.0.0",
  "private": true,
  "description": "Nursing exam preparation with Firebase authentication, Firestore, and Paystack",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
